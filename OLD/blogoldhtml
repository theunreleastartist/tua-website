<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Blog — The Unreleased Artist</title>
<meta name="description" content="Honest writing for music creatives doing it alone. The inner work, the real talk, and the things nobody else is saying."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --gold:#c9973a;--gold-light:#e2b96a;--gold-pale:#f0d9a8;
  --gold-dim:rgba(201,151,58,0.1);--gold-border:rgba(201,151,58,0.22);
  --black:#080808;--navy:#0e0e0e;--navy-card:#141414;
  --text:#f0d9a8;--text-muted:rgba(240,217,168,0.7);--text-dim:rgba(240,217,168,0.35);
  --border:rgba(201,151,58,0.16);
}
html{scroll-behavior:smooth}
body{font-family:'Montserrat',sans-serif;background:var(--black);color:var(--text);font-size:14px;line-height:1.6}
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(8,8,8,0.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 2rem}
.nav-brand{font-family:'Cormorant Garamond',serif;font-size:18px;font-weight:500;color:var(--gold);text-decoration:none}
.nav-links{display:flex;align-items:center;gap:1.5rem;list-style:none}
.nav-links a{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-muted);text-decoration:none;transition:color .2s}
.nav-links a:hover{color:var(--gold)}
.nav-cta{background:transparent;border:1px solid var(--gold-border);color:var(--gold)!important;padding:8px 18px;border-radius:2px}
.nav-cta:hover{background:var(--gold-dim)!important}
@media(max-width:640px){.nav-links li:not(:last-child){display:none}}

/* HERO */
.blog-hero{padding:120px 2rem 4rem;text-align:center;max-width:700px;margin:0 auto;position:relative}
.blog-hero::before{content:'';position:fixed;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(201,151,58,.05) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}
.blog-eyebrow{font-size:10px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem}
.blog-title{font-family:'Cormorant Garamond',serif;font-size:clamp(40px,6vw,64px);font-weight:500;color:var(--gold-pale);line-height:1.05;margin-bottom:1rem}
.blog-sub{font-size:15px;color:var(--text-muted);line-height:1.8;font-weight:300;max-width:480px;margin:0 auto 2rem}
.divider-row{display:flex;align-items:center;gap:12px;justify-content:center;margin-bottom:3rem}
.divider-line{flex:1;max-width:80px;height:1px;background:var(--gold-border)}
.divider-dot{width:4px;height:4px;border-radius:50%;background:var(--gold)}

/* POSTS */
.posts-wrap{max-width:800px;margin:0 auto;padding:0 2rem 6rem}
.posts-eyebrow{font-size:10px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:2rem;padding-bottom:.75rem;border-bottom:1px solid var(--border)}
.post-card{display:grid;grid-template-columns:1fr;gap:0;background:var(--navy-card);border:1px solid var(--border);border-radius:6px;margin-bottom:1.5rem;text-decoration:none;transition:border-color .2s;overflow:hidden}
.post-card:hover{border-color:var(--gold-border)}
.post-card-inner{padding:2rem}
.post-category{font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);margin-bottom:.75rem}
.post-title{font-family:'Cormorant Garamond',serif;font-size:clamp(24px,3.5vw,34px);font-weight:500;color:var(--gold-pale);line-height:1.15;margin-bottom:.75rem}
.post-excerpt{font-size:14px;color:var(--text-muted);line-height:1.75;margin-bottom:1.25rem;font-weight:300}
.post-meta{display:flex;align-items:center;gap:.75rem;font-size:12px;color:var(--text-dim)}
.post-dot{font-size:8px}
.post-read-more{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-top:1.25rem;display:inline-flex;align-items:center;gap:6px}

/* EMAIL SIGNUP */
.signup-section{background:var(--navy);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:4rem 2rem;text-align:center;margin-top:2rem}
.signup-inner{max-width:500px;margin:0 auto}
.signup-title{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:500;color:var(--gold-pale);margin-bottom:.75rem}
.signup-sub{font-size:14px;color:var(--text-muted);line-height:1.8;margin-bottom:1.75rem;font-weight:300}
.signup-form{display:flex;gap:0;border:1px solid var(--gold-border);border-radius:3px;overflow:hidden;max-width:420px;margin:0 auto 1rem}
.signup-form:focus-within{border-color:var(--gold)}
.signup-input{flex:1;background:var(--black);border:none;padding:13px 16px;font-family:'Montserrat',sans-serif;font-size:13px;color:var(--text);outline:none;min-width:0}
.signup-input::placeholder{color:var(--text-dim)}
.signup-btn{background:var(--gold);color:var(--black);border:none;padding:13px 20px;font-family:'Montserrat',sans-serif;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:background .2s;white-space:nowrap;flex-shrink:0}
.signup-btn:hover{background:var(--gold-light)}
.signup-note{font-size:11px;color:var(--text-dim)}
.signup-success{display:none;font-family:'Cormorant Garamond',serif;font-size:18px;font-style:italic;color:var(--gold);margin-top:.5rem}

/* FOOTER */
footer{background:var(--navy);border-top:1px solid var(--gold-border);padding:3rem 2rem;text-align:center}
.footer-brand{font-family:'Cormorant Garamond',serif;font-size:18px;color:var(--gold);margin-bottom:.25rem}
.footer-tagline{font-size:13px;color:var(--text-dim);font-style:italic;font-family:'Cormorant Garamond',serif;margin-bottom:1.25rem}
.footer-links{display:flex;justify-content:center;gap:2rem;flex-wrap:wrap;margin-bottom:1rem}
.footer-links a{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);text-decoration:none;transition:color .2s}
.footer-links a:hover{color:var(--gold)}
.footer-copy{font-size:11px;color:var(--text-dim)}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
</style>
</head>
