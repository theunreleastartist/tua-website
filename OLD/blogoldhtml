<footer>
    <!-- FOOTER EMAIL SIGNUP -->
    <div id="footer-signup" style="background:#141414; border:1px solid rgba(201,151,58,0.22); border-radius:8px; padding:2.5rem 2rem; max-width:540px; margin:0 auto 3rem; text-align:center;">
      <div style="font-size:10px; font-weight:600; letter-spacing:.22em; text-transform:uppercase; color:#c9973a; margin-bottom:0.75rem;">Stay in the loop</div>
      <p style="font-family:'Cormorant Garamond',serif; font-size:22px; font-weight:500; color:#f0d9a8; line-height:1.4; margin-bottom:0.5rem;">Weekly insight for music creatives doing it alone.</p>
      <p style="font-size:13px; color:rgba(240,217,168,0.7); margin-bottom:1.5rem; font-weight:300; line-height:1.7;">Short, honest, and worth reading. No fluff. No spam. Unsubscribe anytime.</p>
      <div id="fs-form" style="display:flex; border:1px solid rgba(201,151,58,0.25); border-radius:3px; overflow:hidden; max-width:400px; margin:0 auto 0.75rem;">
        <input type="email" id="fs-email" placeholder="Your email address" style="flex:1; background:#080808; border:none; padding:13px 16px; font-family:'Montserrat',sans-serif; font-size:13px; color:#f0d9a8; outline:none; min-width:0;" onkeydown="if(event.key==='Enter') fsSignup()"/>
        <button onclick="fsSignup()" style="background:#c9973a; color:#080808; border:none; padding:13px 18px; font-family:'Montserrat',sans-serif; font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; white-space:nowrap; flex-shrink:0;">Join the list</button>
      </div>
      <div id="fs-success" style="display:none; font-family:'Cormorant Garamond',serif; font-size:18px; font-style:italic; color:#c9973a;">You are in. See you in your inbox.</div>
    </div>
    <script>function fsSignup(){var e=document.getElementById("fs-email").value.trim();if(!e||!e.includes("@")){document.getElementById("fs-email").focus();return;}document.getElementById("fs-form").style.display="none";document.getElementById("fs-success").style.display="block";}</script>

