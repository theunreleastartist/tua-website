<script>
function signupBlog() {
  const email = document.getElementById('blog-email').value.trim();
  if (!email || !email.includes('@')) { document.getElementById('blog-email').focus(); return; }
  document.getElementById('signup-wrap').style.display = 'none';
  document.getElementById('signup-success').style.display = 'block';
}
document.getElementById('blog-email').addEventListener('keydown', e => { if (e.key === 'Enter') signupBlog(); });
</script>
